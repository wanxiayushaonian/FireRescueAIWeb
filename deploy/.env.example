# ===== firerescue-bff (Next.js BFF) =====
# 场景数据访问密钥,从本机 .env.local 复制
NEXT_PUBLIC_X_APP_KEY=<从本地 .env.local 复制>
NEXT_PUBLIC_USTUDIO_BASE=https://fc.xwbuilders.com
USTUDIO_GATEWAY=https://fc.xwbuilders.com
NEXT_PUBLIC_LOCALE=zh-CN
# 前端浏览器订阅 mcp 命令流的地址(浏览器能访问的 mcp /scene-events 公网地址)
NEXT_PUBLIC_SCENE_EVENTS_URL=http://<服务器公网IP>:8787/scene-events

# BFF 需要暴露给 mcp-server 的端口(容器内 3000,无需改)
# BFF 自身端口映射如果需要对外,取消下面注释
# BFF_PORT=3000

# ===== firerescue-mcp (MCP server) =====
# agent 端认证 key(任意强随机串,agent URL 里要带上)
MCP_APP_KEY=replace-with-a-strong-random-key
MCP_PORT=8787

# BFF 地址:mcp 容器内用服务名 bff;如需改端口映射,同步改 docker-compose
WEB_BFF_URL=http://bff:3000

# mcp 调 BFF 时带的 x-app-key(与 NEXT_PUBLIC_X_APP_KEY 同值)
WEB_X_APP_KEY=<从本地 .env.local 复制,同 NEXT_PUBLIC_X_APP_KEY>

# 场景 ID:真实 sceneId
SCENE_ID=<真实 sceneId,如 463961468455870464>

# CORS 允许来源:浏览器前端地址(有就用,没可留空)
CORS_ORIGIN=
